# ============================================
# gduf-web 环境配置模板
# 使用方式：
#   cp .env.example .env.development   # 开发
#   cp .env.example .env.production    # 生产/部署
# 也可按 Vite mode 复制为 .env.localhost / .env.pre / .env.test
# 注意：本仓库 .gitignore 已忽略 .env*，仅 .env.example 入库。
# ============================================

# 运行模式（development / production），Vite 通常会按 --mode 自动设置
NODE_ENV=development

# 页面标题
VITE_APP_TITLE='SmartAdmin'

# 主后端（Spring Boot）API 地址
VITE_APP_API_URL='http://127.0.0.1:1024'

# 成绩服务（Node.js）API 地址；需与 gduf-nodejs 的地址一致（经 Vite 代理转发）
VITE_APP_GRADE_API_URL='http://localhost:5000'

# 监控面板令牌：必须与 gduf-nodejs 后端的 DASHBOARD_TOKEN 完全一致，否则看板 SSE 鉴权失败
# ⚠️ 密钥，不要提交到仓库
VITE_APP_DASHBOARD_TOKEN=''